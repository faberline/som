{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faberlines.local/som/som.dsl.v1.schema.json",
  "title": "SOM DSL v1 structure",
  "description": "The approved block library validates each params object and its typed values. The assembler also checks safe paths, reserved names, ordering, and references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "files"],
  "properties": {
    "version": {"const": "som.dsl.v1"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "blocks"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Before assembly, {package} and {migration.revision} may name validated prompt values.",
            "pattern": "^[A-Za-z_0-9/{}.\\-]+\\.py$"
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "id", "params", "refs"],
              "properties": {
                "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"},
                "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
                "params": {
                  "type": "object",
                  "description": "Each value is typed by the approved block. A value may be {$ref: prompt.path}, where prompt.path is one of the service's approved prompt references."
                },
                "refs": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    }
  }
}
