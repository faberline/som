{
  "$comment": "Structural schema only. The semantic validator also checks types, scopes, dependencies, capabilities, permissions, compensation and total budgets.",
  "$defs": {
    "exports": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "else": {
            "$ref": "#/$defs/runtime_ref"
          },
          "then": {
            "$ref": "#/$defs/runtime_ref"
          }
        },
        "required": [
          "then",
          "else"
        ],
        "type": "object"
      },
      "propertyNames": {
        "maxLength": 64,
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
        "type": "string"
      },
      "type": "object"
    },
    "node": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "args": {
              "additionalProperties": {
                "$ref": "#/$defs/runtime_ref"
              },
              "propertyNames": {
                "maxLength": 64,
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                "type": "string"
              },
              "type": "object"
            },
            "id": {
              "enum": [
                "flow.gcs.object.get",
                "flow.gcs.object.put",
                "flow.mongodb.authorize",
                "flow.mongodb.batch.create",
                "flow.mongodb.child.create",
                "flow.mongodb.child.get",
                "flow.mongodb.child.get.checked",
                "flow.mongodb.child.list",
                "flow.mongodb.child.patch",
                "flow.mongodb.parent.create",
                "flow.mongodb.parent.get",
                "flow.mongodb.parent.get.checked",
                "flow.mongodb.parent.list",
                "flow.mongodb.parent.patch",
                "flow.mongodb.workflow.import",
                "flow.mongodb.workflow.run",
                "flow.postgresql.authorize",
                "flow.postgresql.batch.create",
                "flow.postgresql.child.create",
                "flow.postgresql.child.get",
                "flow.postgresql.child.get.checked",
                "flow.postgresql.child.list",
                "flow.postgresql.child.patch",
                "flow.postgresql.parent.create",
                "flow.postgresql.parent.get",
                "flow.postgresql.parent.get.checked",
                "flow.postgresql.parent.list",
                "flow.postgresql.parent.patch",
                "flow.postgresql.workflow.import",
                "flow.postgresql.workflow.run",
                "flow.s3.object.get",
                "flow.s3.object.put"
              ]
            },
            "name": {
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "type": "string"
            },
            "undo": {
              "enum": [
                null,
                "flow.gcs.undo.delete_created",
                "flow.mongodb.undo.delete_created",
                "flow.mongodb.undo.restore_patch",
                "flow.postgresql.undo.delete_created",
                "flow.postgresql.undo.restore_patch",
                "flow.s3.undo.delete_created"
              ]
            }
          },
          "required": [
            "name",
            "id",
            "args",
            "undo"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "enum": [
                "flow.mongodb.transaction",
                "flow.postgresql.transaction"
              ]
            },
            "name": {
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "type": "string"
            },
            "steps": {
              "$ref": "#/$defs/nodes"
            }
          },
          "required": [
            "name",
            "id",
            "steps"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "condition": {
              "$ref": "#/$defs/predicate"
            },
            "else": {
              "$ref": "#/$defs/nodes"
            },
            "exports": {
              "$ref": "#/$defs/exports"
            },
            "id": {
              "enum": [
                "flow.if"
              ]
            },
            "name": {
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "type": "string"
            },
            "then": {
              "$ref": "#/$defs/nodes"
            }
          },
          "required": [
            "name",
            "id",
            "condition",
            "then",
            "else",
            "exports"
          ],
          "type": "object"
        }
      ]
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/node"
      },
      "maxItems": 12,
      "type": "array"
    },
    "predicate": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "left": {
              "$ref": "#/$defs/runtime_ref"
            },
            "op": {
              "const": "is_null"
            }
          },
          "required": [
            "op",
            "left"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "left": {
              "$ref": "#/$defs/runtime_ref"
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "lt",
                "le",
                "gt",
                "ge"
              ]
            },
            "right": {
              "$ref": "#/$defs/runtime_ref"
            }
          },
          "required": [
            "op",
            "left",
            "right"
          ],
          "type": "object"
        }
      ]
    },
    "results": {
      "additionalProperties": {
        "$ref": "#/$defs/runtime_ref"
      },
      "propertyNames": {
        "maxLength": 64,
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
        "type": "string"
      },
      "type": "object"
    },
    "runtime_ref": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "input": {
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "type": "string"
            }
          },
          "required": [
            "input"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string"
            },
            "step": {
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "type": "string"
            }
          },
          "required": [
            "step",
            "field"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "literal": {},
            "type": {
              "enum": [
                "boolean",
                "bytes",
                "date",
                "float",
                "integer",
                "string"
              ]
            }
          },
          "required": [
            "literal",
            "type"
          ],
          "type": "object"
        }
      ]
    }
  },
