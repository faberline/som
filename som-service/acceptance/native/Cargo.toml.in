[package]
name = "som-defer-dfr07-native"
version = "0.1.0"
edition = "2021"
[workspace]
[dependencies]
anyhow = "1.0"
chrono = { version = "0.4", features = ["serde"] }
defer-access = { path = "../defer/crates/defer-access" }
defer-dispatch = { path = "../defer/crates/defer-dispatch" }
defer-queue = { path = "../defer/crates/defer-queue" }
defer-replication = { path = "../defer/crates/defer-replication" }
defer-shared-kernel = { path = "../defer/crates/defer-shared-kernel" }
raft-runtime = { git = "https://github.com/faberline/core", tag = "v0.4.14" }
service-http = { git = "https://github.com/faberline/core", tag = "v0.4.14" }
serde_json = "1.0"
tempfile = "3"
tokio = { version = "1.40", features = ["full"] }
[profile.dev]
debug = 0
